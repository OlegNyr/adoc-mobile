<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Git-слой (фича 007): clone/fetch/pull/push ходят по HTTPS к remote
      пользователя. Другие сетевые потребители — Kroki (фича рендера диаграмм).
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Резервная копия включена, но приватные файлы Git-слоя из неё исключены
      (фича 007, TC-58): доверенные отпечатки серверов не смеют переезжать на
      устройство, где их никто не подтверждал (FR-29). Наборов два, потому что
      системы до Android 12 читают fullBackupContent, а с 12 —
      dataExtractionRules; пропуск одного оставил бы половину устройств без
      исключения.
    -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="AsciiDoc Mobile"
        android:supportsRtl="true"
        android:theme="@style/Theme.AdocMobile">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
