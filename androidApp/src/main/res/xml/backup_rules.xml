<?xml version="1.0" encoding="utf-8"?>
<!--
  Правила автобэкапа для Android до 12 (фича 007, TC-58).

  Тот же каталог, что и в data_extraction_rules.xml: два набора правил живут
  для разных версий системы, и пропуск одного из них означал бы, что на
  половине устройств доверенные отпечатки серверов всё-таки уезжают в копию.
-->
<full-backup-content>
    <exclude domain="file" path="git/" />
</full-backup-content>
